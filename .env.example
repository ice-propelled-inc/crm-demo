# Copy to .env and fill in. Do not commit .env.

DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat
PUBLIC_BASE_URL=http://localhost:8000

# Session cookies and credentials kept in the database.
# Make a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET_KEY=change-me
# ENCRYPTION_KEY=<generated key>   (required in production; the dev default is used when unset)

# LLM. "mock" = offline model (no real answers). "openai_compat" = Ollama, Gemini or Groq
# for free tests (README: "Test the bot without a paid API"). Production: Claude Sonnet 5.5.
LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=300
# "none" switches off model thinking (qwen3 on Ollama: about 5x faster on a CPU)
LLM_REASONING_EFFORT=
# Embeddings: "mock" or "openai_compat". The model must give 1024 dimensions.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mxbai-embed-large

# WhatsApp Business Cloud API (notifications only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=operator_handoff
WHATSAPP_URGENT_TEMPLATE_NAME=urgent_handoff

# Meta Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Twilio (urgent phone calls)
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_FROM_NUMBER=

OPERATOR_CHAT_URL=http://localhost:8000/operator
LOG_LEVEL=INFO

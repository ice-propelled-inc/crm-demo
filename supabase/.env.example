# Edge Function secrets. Set them with:  supabase secrets set --env-file supabase/.env
# Never commit the real .env file. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

# Public base URL of the GitHub Pages site that serves agent-config.json and schedule.json
PAGES_BASE_URL=https://<user>.github.io/<repo>
# Optional: folder of the other business sets under PAGES_BASE_URL (default crm-demo-local/businesses)
# BUSINESSES_PATH=crm-demo-local/businesses
# Public URL of the functions, used for Twilio callbacks and signature checks
FUNCTIONS_PUBLIC_URL=https://<project-ref>.supabase.co/functions/v1

# Optional PIN the page asks for before it can use the softphone, Deepgram and the observer
ADMIN_PIN=

# Vapi: header x-vapi-secret on the assistant's server URL, and the SIP URI of the assistant
VAPI_SECRET=
VAPI_SIP_URI=sip:<name>@sip.vapi.ai

# Twilio: auth token for webhook signatures, API key for softphone tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Telnyx (only for the docs/crm-demo-tx page): API key, webhook public key (base64),
# telephony credential id and SIP username of the credential connection the softphone registers on
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CREDENTIAL_ID=
TELNYX_SIP_USERNAME=

# Deepgram (UC2 transcription)
DEEPGRAM_API_KEY=

# OpenAI-compatible LLM for the UC2 observer
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
